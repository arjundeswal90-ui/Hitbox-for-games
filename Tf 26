-- Find All Football Parts
local function getAllBalls()
	local balls = {}
	for _, obj in pairs(Workspace:GetDescendants()) do
		if obj:IsA("BasePart") or obj:IsA("MeshPart") then
			local name = obj.Name:lower()
			if name:find("ball") or name:find("football") or name:find("soccer") or obj:FindFirstChild("TouchInterest") then
				if not obj:IsDescendantOf(Players) and obj.Size.Magnitude < 10 then
					table.insert(balls, obj)
				end
			end
		end
	end
	return balls
end

-- Create Translucent Blue Custom Hitbox Part Attached To Ball
local function createCustomHitbox(realBall)
	if CreatedHitboxes[realBall] and CreatedHitboxes[realBall].Parent then
		return CreatedHitboxes[realBall]
	end

	local fakeHitbox = Instance.new("Part")
	fakeHitbox.Name = "TF26_Blue_Hitbox"
	fakeHitbox.Shape = Enum.PartType.Ball
	fakeHitbox.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
	fakeHitbox.Material = Enum.Material.Neon
	fakeHitbox.Color = Color3.fromRGB(0, 150, 255)
	fakeHitbox.Transparency = 0.65
	fakeHitbox.CanCollide = false
	fakeHitbox.Anchored = false
	fakeHitbox.Massless = true

	-- Selection Box Outline
	local box = Instance.new("SelectionBox")
	box.Color3 = Color3.fromRGB(0, 230, 255)
	box.LineThickness = 0.05
	box.Adornee = fakeHitbox
	box.Parent = fakeHitbox

	fakeHitbox.Parent = Workspace
	CreatedHitboxes[realBall] = fakeHitbox
	return fakeHitbox
end

-- Render Frame Lock Loop
RunService.RenderStepped:Connect(function()
	if HitboxEnabled then
		local balls = getAllBalls()
		for _, realBall in pairs(balls) do
			local hitbox = createCustomHitbox(realBall)
			hitbox.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
			hitbox.CFrame = realBall.CFrame
			
			-- Re-trigger Ball Touch when player steps into Blue Area
			local char = LocalPlayer.Character
			if char and char:FindFirstChild("HumanoidRootPart") then
				local dist = (char.HumanoidRootPart.Position - realBall.Position).Magnitude
				if dist <= (HitboxSize / 2) + 2 then
					pcall(function()
						firetouchinterest(char.HumanoidRootPart, realBall, 0)
						firetouchinterest(char.HumanoidRootPart, realBall, 1)
					end)
				end
			end
		end
	else
		for realBall, hitbox in pairs(CreatedHitboxes) do
			if hitbox then
				hitbox:Destroy()
			end
		end
		CreatedHitboxes = {}
	end
end)

