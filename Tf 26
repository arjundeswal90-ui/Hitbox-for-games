-- Decrease Button (-)
local MinusBtn = Instance.new("TextButton")
MinusBtn.Parent = MainFrame
MinusBtn.Position = UDim2.new(0.1, 0, 0.72, 0)
MinusBtn.Size = UDim2.new(0.35, 0, 0, 28)
MinusBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
MinusBtn.Text = "-"
MinusBtn.Font = Enum.Font.SourceSansBold
MinusBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
MinusBtn.TextSize = 18
Instance.new("UICorner", MinusBtn).CornerRadius = UDim.new(0, 6)

-- Increase Button (+)
local PlusBtn = Instance.new("TextButton")
PlusBtn.Parent = MainFrame
PlusBtn.Position = UDim2.new(0.55, 0, 0.72, 0)
PlusBtn.Size = UDim2.new(0.35, 0, 0, 28)
PlusBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
PlusBtn.Text = "+"
PlusBtn.Font = Enum.Font.SourceSansBold
PlusBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
PlusBtn.TextSize = 18
Instance.new("UICorner", PlusBtn).CornerRadius = UDim.new(0, 6)

-- Helper function to find the football object in Workspace
local function getBall()
	for _, v in pairs(Workspace:GetDescendants()) do
		if (v.Name:lower():sub(1,4) == "ball" or v.Name == "Football" or v:IsA("Part") and v.Name:find("Ball")) and v:IsA("BasePart") then
			return v
		end
	end
	return nil
end

-- Function to Apply Blue Highlight Area
local function addHighlight(ball)
	if not BlueHighlights[ball] then
		local hl = Instance.new("SelectionBox")
		hl.Name = "BlueHitboxHighlight"
		hl.Color3 = Color3.fromRGB(0, 150, 255) -- Blue Color
		hl.LineThickness = 0.08
		hl.Adornee = ball
		hl.Parent = ball
		
		local highlightGlow = Instance.new("Highlight")
		highlightGlow.Name = "BlueGlow"
		highlightGlow.FillColor = Color3.fromRGB(0, 120, 255)
		highlightGlow.FillTransparency = 0.65 -- Light Blue Fill
		highlightGlow.OutlineColor = Color3.fromRGB(0, 220, 255)
		highlightGlow.Parent = ball
		
		BlueHighlights[ball] = {hl, highlightGlow}
	end
end

-- Function to Remove Highlight
local function removeHighlight(ball)
	if BlueHighlights[ball] then
		for _, v in pairs(BlueHighlights[ball]) do
			pcall(function() v:Destroy() end)
		end
		BlueHighlights[ball] = nil
	end
end

-- Main Loop
RunService.RenderStepped:Connect(function()
	local ball = getBall()
	if ball then
		if not OriginalBallSizes[ball] then
			OriginalBallSizes[ball] = ball.Size
		end

		if HitboxEnabled then
			ball.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
			ball.CanCollide = false -- Prevents physics glitch while kicking
			addHighlight(ball)
		else
			if OriginalBallSizes[ball] then
				ball.Size = OriginalBallSizes[ball]
			end
			removeHighlight(ball)
		end
	end
end)

-- UI Click Events
ToggleBtn.MouseButton1Click:Connect(function()
	HitboxEnabled = not HitboxEnabled
	if HitboxEnabled then
		ToggleBtn.Text = "Hitbox: ON"
		ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
	else
		ToggleBtn.Text = "Hitbox: OFF"
		ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
	end
end)

PlusBtn.MouseButton1Click:Connect(function()
	HitboxSize = HitboxSize + 2
	SizeLabel.Text = "Hitbox Size: " .. tostring(HitboxSize)
end)

MinusBtn.MouseButton1Click:Connect(function()
	if HitboxSize > 2 then
		HitboxSize = HitboxSize - 2
		SizeLabel.Text = "Hitbox Size: " .. tostring(HitboxSize)
	end
end)
