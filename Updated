-- Deep Scan for All Potential Ball Objects
local function findAllBalls()
	local found = {}
	for _, instance in pairs(Workspace:GetDescendants()) do
		if instance:IsA("BasePart") or instance:IsA("MeshPart") then
			local n = instance.Name:lower()
			if (n:find("ball") or n:find("football") or n:find("soccer") or n == "tp" or instance:FindFirstChildOfClass("TouchTransmitter")) then
				if not instance:IsDescendantOf(Players) and instance.Name ~= "Flames_Universal_Part" then
					table.insert(found, instance)
				end
			end
		end
	end
	return found
end

-- Create Translucent Visual Part
local function createOrGetVisual(targetPart)
	if ActiveHitboxes[targetPart] and ActiveHitboxes[targetPart].Parent then
		return ActiveHitboxes[targetPart]
	end

	local vis = Instance.new("Part")
	vis.Name = "Flames_Universal_Part"
	vis.Shape = Enum.PartType.Ball
	vis.Material = Enum.Material.ForceField
	vis.Color = Color3.fromRGB(0, 160, 255)
	vis.Transparency = 0.35
	vis.CanCollide = false
	vis.Anchored = true
	vis.CastShadow = false
	vis.Parent = Workspace

	ActiveHitboxes[targetPart] = vis
	return vis
end

-- Render Execution
RunService.RenderStepped:Connect(function()
	if HitboxEnabled then
		local ballList = findAllBalls()
		for _, ballPart in pairs(ballList) do
			local visual = createOrGetVisual(ballPart)
			visual.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
			visual.CFrame = ballPart.CFrame

			-- Local Physics Trigger
			local char = LocalPlayer.Character
			if char and char:FindFirstChild("HumanoidRootPart") then
				local dist = (char.HumanoidRootPart.Position - ballPart.Position).Magnitude
				if dist <= (HitboxSize / 2) + 2 then
					pcall(function()
						firetouchinterest(char.HumanoidRootPart, ballPart, 0)
						firetouchinterest(char.HumanoidRootPart, ballPart, 1)
					end)
				end
			end
		end
	else
		for original, visPart in pairs(ActiveHitboxes) do
			if visPart then
				pcall(function() visPart:Destroy() end)
			end
		end
		ActiveHitboxes = {}
	end
end)

